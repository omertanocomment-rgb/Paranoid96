# Anthropic API key (required). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional shared secret. When set, the app MUST send it as the x-omerta-key
# header, otherwise requests are rejected. Leave unset for open/dev mode.
OMERTA_APP_TOKEN=

# Default model + effort (overridable per request by the app).
OMERTA_MODEL=claude-opus-5
OMERTA_EFFORT=high

# Server port.
PORT=8080

# Comma-separated allowed CORS origins. "*" allows all (default).
CORS_ORIGINS=*
