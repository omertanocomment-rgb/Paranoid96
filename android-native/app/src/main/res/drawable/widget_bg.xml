<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's panel: the same flat surface with a hairline border that
     every screen inside the app uses, so it does not read as a different
     application sitting on the home screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="#141210"/>
    <stroke android:width="1dp" android:color="#2A2724"/>
    <corners android:radius="10dp"/>
</shape>
