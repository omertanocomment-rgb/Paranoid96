<?xml version="1.0" encoding="utf-8"?>
<!-- The app stores the backend token in SharedPreferences. With backups
     enabled, `adb backup` or a cloud restore would carry that token off the
     device. Nothing here is worth backing up, so everything is excluded. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="sharedpref" />
        <exclude domain="database" /><exclude domain="file" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="sharedpref" />
        <exclude domain="database" /><exclude domain="file" /></device-transfer>
</data-extraction-rules>
